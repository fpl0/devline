  <licenses>
    <license>
      <name>MIT License</name>
      <url>http://www.opensource.org/licenses/mit-license.php</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>eskombro</id>
      <name>Samuel Jimenez</name>
      <email>samuel@meilisearch.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/meilisearch/meilisearch-java.git</connection>
    <developerConnection>scm:git:ssh://github.com:meilisearch/meilisearch-java.git</developerConnection>
    <url>http://github.com/meilisearch/meilisearch-java</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>5.3.2</version>
