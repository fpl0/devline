  <modelVersion>4.0.0</modelVersion>
  <groupId>com.meilisearch.sdk</groupId>
  <artifactId>meilisearch-java</artifactId>
  <version>0.22.1</version>
  <name>com.meilisearch.sdk:meilisearch-java</name>
  <description>Meilisearch is a powerful, fast, open-source, easy to use and deploy search engine.</description>
