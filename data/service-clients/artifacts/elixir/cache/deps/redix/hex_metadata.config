{<<"app">>,<<"redix">>}.
{<<"build_tools">>,[<<"mix">>]}.
{<<"description">>,<<"Fast, pipelined, resilient Redis driver for Elixir.">>}.
{<<"elixir">>,<<"~> 1.15">>}.
{<<"files">>,
 [<<".formatter.exs">>,
  <<"CHANGELOG.md">>,
  <<"LICENSE.txt">>,
  <<"README.md">>,
  <<"lib">>,
  <<"lib/redix">>,
  <<"lib/redix.ex">>,
  <<"lib/redix/cluster">>,
  <<"lib/redix/cluster.ex">>,
  <<"lib/redix/cluster/command_parser.ex">>,
  <<"lib/redix/cluster/hash.ex">>,
  <<"lib/redix/cluster/key_resolver.ex">>,
  <<"lib/redix/cluster/manager.ex">>,
  <<"lib/redix/connection.ex">>,
  <<"lib/redix/connector.ex">>,
  <<"lib/redix/exceptions.ex">>,
  <<"lib/redix/format.ex">>,
  <<"lib/redix/protocol.ex">>,
  <<"lib/redix/pubsub">>,
  <<"lib/redix/pubsub.ex">>,
  <<"lib/redix/pubsub/connection.ex">>,
  <<"lib/redix/socket_owner.ex">>,
  <<"lib/redix/start_options.ex">>,
  <<"lib/redix/telemetry.ex">>,
  <<"lib/redix/uri.ex">>,
  <<"mix.exs">>]}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"links">>,
 [{<<"GitHub">>,<<"https://github.com/whatyouhide/redix">>},
  {<<"Sponsor">>,<<"https://github.com/sponsors/whatyouhide">>}]}.
{<<"name">>,<<"redix">>}.
{<<"requirements">>,
 [[{<<"app">>,<<"telemetry">>},
   {<<"name">>,<<"telemetry">>},
   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"~> 0.4.0 or ~> 1.0">>}],
  [{<<"app">>,<<"castore">>},
   {<<"name">>,<<"castore">>},
   {<<"optional">>,true},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"~> 0.1.0 or ~> 1.0">>}],
  [{<<"app">>,<<"nimble_options">>},
   {<<"name">>,<<"nimble_options">>},
   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"~> 0.5.0 or ~> 1.0">>}]]}.
{<<"version">>,<<"1.10.0">>}.
