<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Workshop Desk</title>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <main>
      <% flash.each do |kind, message| %>
        <p class="flash <%= kind %>" role="<%= kind == 'alert' ? 'alert' : 'status' %>"><%= message %></p>
      <% end %>
      <%= yield %>
      <footer>Workshop Desk · Local workspace · Amounts in EUR</footer>
    </main>
  </body>
</html>
