{
  "productName": "Fieldnotes",
  "version": "0.1.0",
  "identifier": "io.devline.fieldnotes",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fieldnotes",
        "width": 1050,
        "height": 730,
        "minWidth": 660,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
