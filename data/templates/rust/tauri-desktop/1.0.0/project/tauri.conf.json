{
  "productName": "Local Text Inspector",
  "version": "0.1.0",
  "identifier": "io.devline.text-inspector",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Local Text Inspector",
        "width": 740,
        "height": 610,
        "minWidth": 420,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
